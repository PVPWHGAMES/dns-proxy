{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DNS Proxy",
  "version": "1.2.1",
  "identifier": "com.dnsproxy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "果冻网络加速",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "bin/WinDivert.dll": "WinDivert.dll",
      "bin/WinDivert64.sys": "WinDivert64.sys",
      "bin/LICENSE-WinDivert.txt": "LICENSE-WinDivert.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
